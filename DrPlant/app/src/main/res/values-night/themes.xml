<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Giữ giao diện sáng cả khi điện thoại bật Dark mode (các màn hình khác đang dùng nền sáng cố định). -->
    <style name="Base.Theme.DrPlant" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/dp_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/dp_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/dp_primary_dark</item>
        <item name="colorSecondary">@color/dp_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/dp_danger</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/dp_text_primary</item>
        <item name="android:windowBackground">@color/dp_background</item>
    </style>
</resources>
